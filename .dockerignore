# --- recursive ignores to keep context tiny ---
**/node_modules
**/.pnpm-store
**/.turbo
**/.cache
**/dist
**/build
**/.next
**/coverage

# Node dependencies and build outputs
node_modules
dist
build
.next
out
.cache
coverage
.nyc_output
.turbo
.webpack
.temp

# Package manager caches
.pnpm-store
.yarn
.yarnrc*
.npm

# Logs and reports
*.log
*.tgz
*.pid
*.seed
*.tsbuildinfo

# Environment & secrets
.env
.env.*
!.env.example
!apps/backend/.env.example
!apps/mobile/.env.example

# System files
.DS_Store
Thumbs.db

# Version control
.git
.gitignore

# Editor / IDE
.vscode
.idea

# Tests (optional if you don’t need them in image)
__tests__/
test/
*.spec.js
*.spec.ts

# Lint / config caches
.eslintcache
.stylelintcache

# Optional: OS-level cruft
*.swp
*.bak
